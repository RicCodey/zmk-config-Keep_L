	#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	chosen {
		zmk,kscan = &kscan_matrix;
		zmk,matrix-transform = &default_transform;
		zephyr,display = &oled;
	};

	/*
	 * ============================================================
	 * 29-KEY MATRIX
	 * ============================================================
	 *
	 * Diodes:
	 * COLUMN -> DIODE -> ROW
	 *
	 * Physical columns, left -> right:
	 *
	 * C1 = P1.15
	 * C2 = P1.13
	 * C3 = P1.11
	 * C4 = P0.10
	 * C5 = P0.09
	 * C6 = P1.06
	 * C7 = P1.04
	 *
	 * Physical rows, top -> bottom:
	 *
	 * R1 = P0.02
	 * R2 = P0.22
	 * R3 = P0.24
	 * R4 = P1.00
	 * R5 = P0.11
	 */

	kscan_matrix: kscan_matrix {
		compatible = "zmk,kscan-gpio-matrix";

		diode-direction = "col2row";

		/* Rows */
		row-gpios =
			<&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
			<&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
			<&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
			<&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
			<&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

		/* Columns */
		col-gpios =
			<&gpio1 15 GPIO_ACTIVE_HIGH>,
			<&gpio1 13 GPIO_ACTIVE_HIGH>,
			<&gpio1 11 GPIO_ACTIVE_HIGH>,
			<&gpio0 10 GPIO_ACTIVE_HIGH>,
			<&gpio0 9  GPIO_ACTIVE_HIGH>,
			<&gpio1 6  GPIO_ACTIVE_HIGH>,
			<&gpio1 4  GPIO_ACTIVE_HIGH>;

		/* EC11 rotation */
		sensors {
			compatible = "zmk,keymap-sensors";
			sensors = <&encoder>;
		};
	};


	/*
	 * ============================================================
	 * EC11 PUSH BUTTON
	 * ============================================================
	 *
	 * P1.07 -> SWITCH -> GND
	 *
	 * This button is separate from the 29-key matrix.
	 */

	encoder_button: encoder_button {
		compatible = "zmk,kscan-gpio-direct";

		input-gpios = <
			&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
		>;

		debounce-press-ms = <10>;
		debounce-release-ms = <10>;
	};


	/*
	 * ============================================================
	 * ENCODER BUTTON -> LAYER TOGGLE
	 * ============================================================
	 *
	 * P1.07:
	 *
	 * Press 1: L1 -> L2
	 * Press 2: L2 -> L1
	 */

	sideband: sideband {
		compatible = "zmk,kscan-sideband-behaviors";

		kscan = <&encoder_button>;

		auto-enable;

		encoder_layer {
			row = <0>;
			column = <0>;
			bindings = <&tog 1>;
		};
	};


	/*
	 * ============================================================
	 * MATRIX TRANSFORM
	 * ============================================================
	 *
	 * Physical layout:
	 *
	 * R1: C1 C2 C3 C4 C5 C6
	 * R2: C1 C2 C3 C4 C5 C6
	 * R3: C1 C2 C3 C4 C5 C6 C7
	 * R4: C1 C2 C3 C4 C5 C6
	 * R5:       C3 C4 C5    C7
	 *
	 * 29 keys total.
	 */

	default_transform: matrix_transform {
		compatible = "zmk,matrix-transform";

		columns = <7>;
		rows = <5>;

		map = <
			/* R1 */
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)

			/* R2 */
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)

			/* R3 */
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)

			/* R4 */
			RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)

			/* R5 */
			RC(4,2) RC(4,3) RC(4,4) RC(4,6)
		>;
	};


	/*
	 * ============================================================
	 * EC11 ROTARY ENCODER
	 * ============================================================
	 *
	 * A / CLK = P1.01
	 * B / DT  = P1.02
	 * Push   = P1.07
	 */

	encoder: encoder {
		compatible = "alps,ec11";

		a-gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		b-gpios = <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

		steps = <50>;

		status = "okay";
	};
};


/*
 * ================================================================
 * I2C / OLED
 * ================================================================
 *
 * SDA = P0.17
 * SCL = P0.20
 * Address = 0x3C
 * Size = 128x32
 */

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			psels =
				<NRF_PSEL(TWIM_SDA, 0, 17)>,
				<NRF_PSEL(TWIM_SCL, 0, 20)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels =
				<NRF_PSEL(TWIM_SDA, 0, 17)>,
				<NRF_PSEL(TWIM_SCL, 0, 20)>;

			low-power-enable;
		};
	};
};


&i2c0 {
	status = "okay";

	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	clock-frequency = <I2C_BITRATE_STANDARD>;

	oled: ssd1306@3c {
		compatible = "solomon,ssd1306fb";

		reg = <0x3c>;

		width = <128>;
		height = <32>;

		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;

		multiplex-ratio = <31>;

		com-sequential;

		prechargep = <0x22>;

		status = "okay";
	};
};
