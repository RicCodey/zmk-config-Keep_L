#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;

        /* OLED */
        zephyr,display = &oled;
    };


    /*
     * ========================================================
     * KEY MATRIX
     * ========================================================
     */

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        /*
         * Diode stripe/cathode is toward ROW.
         */
        diode-direction = "col2row";


        /*
         * ROWS
         *
         * Top -> Bottom
         */

        row-gpios =
            <&gpio0 20 GPIO_ACTIVE_HIGH>, /* Row 0 */
            <&gpio0 22 GPIO_ACTIVE_HIGH>, /* Row 1 */
            <&gpio0 24 GPIO_ACTIVE_HIGH>, /* Row 2 */
            <&gpio1 0  GPIO_ACTIVE_HIGH>, /* Row 3 */
            <&gpio0 11 GPIO_ACTIVE_HIGH>; /* Row 4 */


        /*
         * COLUMNS
         *
         * Physical wiring is RIGHT -> LEFT:
         *
         * Physical C7 = P1.15
         * Physical C6 = P1.13
         * Physical C5 = P1.11
         * Physical C4 = P0.10
         * Physical C3 = P0.09
         * Physical C2 = P1.06
         * Physical C1 = P1.04
         *
         * We reverse them in software so:
         *
         * Software C0 = leftmost
         * Software C6 = rightmost
         */

        col-gpios =
            <&gpio1 15 GPIO_ACTIVE_HIGH>, /* C0 */
            <&gpio1 13 GPIO_ACTIVE_HIGH>, /* C1 */
            <&gpio1 11 GPIO_ACTIVE_HIGH>, /* C2 */
            <&gpio0 10 GPIO_ACTIVE_HIGH>, /* C3 */
            <&gpio0 9  GPIO_ACTIVE_HIGH>, /* C4 */
            <&gpio1 6  GPIO_ACTIVE_HIGH>, /* C5 */
            <&gpio1 4  GPIO_ACTIVE_HIGH>; /* C6 */
    };


    /*
     * ========================================================
     * MATRIX TRANSFORM
     * ========================================================
     *
     * 29 keys:
     *
     * Row 0 = 6
     * Row 1 = 6
     * Row 2 = 7
     * Row 3 = 6
     * Row 4 = 4
     */

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        columns = <7>;
        rows = <5>;

        map = <
            /* Row 0 */
            RC(0,0)
            RC(0,1)
            RC(0,2)
            RC(0,3)
            RC(0,4)
            RC(0,5)

            /* Row 1 */
            RC(1,0)
            RC(1,1)
            RC(1,2)
            RC(1,3)
            RC(1,4)
            RC(1,5)

            /* Row 2 */
            RC(2,0)
            RC(2,1)
            RC(2,2)
            RC(2,3)
            RC(2,4)
            RC(2,5)
            RC(2,6)

            /* Row 3 */
            RC(3,0)
            RC(3,1)
            RC(3,2)
            RC(3,3)
            RC(3,4)
            RC(3,5)

            /* Row 4 */
            RC(4,2)
            RC(4,3)
            RC(4,4)
            RC(4,6)
        >;
    };


    /*
     * ========================================================
     * ENCODER
     * ========================================================
     */

    encoder: encoder {
        compatible = "alps,ec11";

        a-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;

        steps = <4>;

        status = "okay";
    };
};


/*
 * ============================================================
 * I2C PIN CONTROL
 * ============================================================
 *
 * OLED:
 *
 * SDA = P0.02
 * SCL = P0.29
 *
 * These are deliberately NOT the normal nice!nano I2C pins
 * because P0.20 is already being used by Matrix Row 0.
 */

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 2)>,
                <NRF_PSEL(TWIM_SCL, 0, 29)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 2)>,
                <NRF_PSEL(TWIM_SCL, 0, 29)>;

            low-power-enable;
        };
    };
};


/*
 * ============================================================
 * I2C0
 * ============================================================
 */

&i2c0 {
    status = "okay";

    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    clock-frequency = <I2C_BITRATE_STANDARD>;


    /*
     * ========================================================
     * SSD1306 0.91" OLED
     * ========================================================
     */

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";

        reg = <0x3c>;

        width = <128>;
        height = <32>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;

        multiplex-ratio = <31>;

        segment-remap;
        com-invdir;
        com-sequential;

        prechargep = <0x22>;

        status = "okay";
    };
};