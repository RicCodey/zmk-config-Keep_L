#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	chosen {
		zmk,kscan = &sideband;
		zmk,matrix-transform = &default_transform;
		zephyr,display = &oled;
	};

	/*
	 * ORIGINAL WORKING MATRIX
	 */
	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";

		diode-direction = "col2row";

		row-gpios =
			<&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
			<&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
			<&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
			<&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
			<&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

		col-gpios =
			<&gpio1 4  GPIO_ACTIVE_HIGH>,
			<&gpio1 6  GPIO_ACTIVE_HIGH>,
			<&gpio0 9  GPIO_ACTIVE_HIGH>,
			<&gpio0 10 GPIO_ACTIVE_HIGH>,
			<&gpio1 11 GPIO_ACTIVE_HIGH>,
			<&gpio1 13 GPIO_ACTIVE_HIGH>,
			<&gpio1 15 GPIO_ACTIVE_HIGH>;

		sensors {
			compatible = "zmk,keymap-sensors";
			sensors = <&encoder>;
		};
	};

	/*
	 * SEPARATE ENCODER PUSHBUTTON
	 * P1.01 -> switch -> GND
	 */
	encoder_button: encoder_button {
		compatible = "zmk,kscan-gpio-direct";

		input-gpios = <
			&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
		>;

		debounce-press-ms = <10>;
		debounce-release-ms = <10>;
	};

	/*
	 * ASSIGN THE PUSHBUTTON DIRECTLY TO TOGGLE LAYER 2
	 */
	sideband: sideband {
		compatible = "zmk,kscan-sideband-behaviors";

		kscan = <&encoder_button>;
		auto-enable;

		encoder_layer {
			row = <0>;
			column = <0>;
			bindings = <&tog 1>;
		};
	};

	/*
	 * ORIGINAL 29-KEY MATRIX TRANSFORM
	 * UNCHANGED
	 */
	default_transform: matrix_transform {
		compatible = "zmk,matrix-transform";

		columns = <7>;
		rows = <5>;

		map = <
			RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)

			RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)

			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)

			RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)

			RC(4,0) RC(4,2) RC(4,3) RC(4,4)
		>;
	};

	/*
	 * EC11
	 * A = P1.02
	 * B = P1.07
	 */
	encoder: encoder {
		compatible = "alps,ec11";

		a-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
		b-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;

		steps = <50>;

		status = "okay";
	};
};

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			psels =
				<NRF_PSEL(TWIM_SDA, 0, 17)>,
				<NRF_PSEL(TWIM_SCL, 0, 20)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels =
				<NRF_PSEL(TWIM_SDA, 0, 17)>,
				<NRF_PSEL(TWIM_SCL, 0, 20)>;

			low-power-enable;
		};
	};
};

&i2c0 {
	status = "okay";

	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	clock-frequency = <I2C_BITRATE_STANDARD>;

	oled: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;

		width = <128>;
		height = <32>;

		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;

		multiplex-ratio = <31>;

		com-sequential;

		prechargep = <0x22>;

		status = "okay";
	};
};