#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    /*
     * ========================================================
     * CHOSEN DEVICES
     * ========================================================
     */

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;

        /*
         * OLED
         */
        zephyr,display = &oled;
    };


    /*
     * ========================================================
     * KEY MATRIX
     * ========================================================
     *
     * ROWS:
     *
     * Row 1 = P0.20 = 6 keys
     * Row 2 = P0.22 = 6 keys
     * Row 3 = P0.24 = 7 keys
     * Row 4 = P1.00 = 6 keys
     * Row 5 = P0.11 = 4 keys
     *
     * TOTAL = 29 keys
     *
     *
     * DIODE:
     *
     * Stripe/cathode is toward ROW.
     *
     * Therefore:
     *
     * col2row
     *
     * ========================================================
     */

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "col2row";


        /*
         * ----------------------------------------------------
         * ROWS
         * ----------------------------------------------------
         *
         * TOP -> BOTTOM
         */

        row-gpios =
            <&gpio0 20 GPIO_ACTIVE_HIGH>, /* Row 1 */
            <&gpio0 22 GPIO_ACTIVE_HIGH>, /* Row 2 */
            <&gpio0 24 GPIO_ACTIVE_HIGH>, /* Row 3 */
            <&gpio1 0  GPIO_ACTIVE_HIGH>, /* Row 4 */
            <&gpio0 11 GPIO_ACTIVE_HIGH>; /* Row 5 */


        /*
         * ----------------------------------------------------
         * COLUMNS
         * ----------------------------------------------------
         *
         * PHYSICAL COLUMN NUMBERING:
         *
         * Column 7 = P1.04
         * Column 6 = P1.06
         * Column 5 = P0.09
         * Column 4 = P0.10
         * Column 3 = P1.11
         * Column 2 = P1.13
         * Column 1 = P1.15
         *
         *
         * We intentionally put them into the software in this
         * order so the physical keyboard is read LEFT -> RIGHT.
         */

        col-gpios =
            <&gpio1 4  GPIO_ACTIVE_HIGH>, /* C0 = physical C7 */
            <&gpio1 6  GPIO_ACTIVE_HIGH>, /* C1 = physical C6 */
            <&gpio0 9  GPIO_ACTIVE_HIGH>, /* C2 = physical C5 */
            <&gpio0 10 GPIO_ACTIVE_HIGH>, /* C3 = physical C4 */
            <&gpio1 11 GPIO_ACTIVE_HIGH>, /* C4 = physical C3 */
            <&gpio1 13 GPIO_ACTIVE_HIGH>, /* C5 = physical C2 */
            <&gpio1 15 GPIO_ACTIVE_HIGH>; /* C6 = physical C1 */
    };


    /*
     * ========================================================
     * MATRIX TRANSFORM
     * ========================================================
     *
     * Row 1 = 6
     * Row 2 = 6
     * Row 3 = 7
     * Row 4 = 6
     * Row 5 = 4
     *
     * TOTAL = 29
     *
     *
     * Row 5 physical positions:
     *
     * Key 1 = physical Column 1
     * Key 2 = physical Column 3
     * Key 3 = physical Column 4
     * Key 4 = physical Column 5
     *
     * Because the software columns are reversed:
     *
     * physical C1 = software C6
     * physical C3 = software C4
     * physical C4 = software C3
     * physical C5 = software C2
     *
     * ========================================================
     */

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        columns = <7>;
        rows = <5>;

        map = <

            /*
             * =================================================
             * ROW 1
             * =================================================
             *
             * 6 keys
             */

            RC(0,0)
            RC(0,1)
            RC(0,2)
            RC(0,3)
            RC(0,4)
            RC(0,5)


            /*
             * =================================================
             * ROW 2
             * =================================================
             *
             * 6 keys
             */

            RC(1,0)
            RC(1,1)
            RC(1,2)
            RC(1,3)
            RC(1,4)
            RC(1,5)


            /*
             * =================================================
             * ROW 3
             * =================================================
             *
             * 7 keys
             *
             * First key is in physical Column 1.
             */

            RC(2,0)
            RC(2,1)
            RC(2,2)
            RC(2,3)
            RC(2,4)
            RC(2,5)
            RC(2,6)


            /*
             * =================================================
             * ROW 4
             * =================================================
             *
             * 6 keys
             */

            RC(3,0)
            RC(3,1)
            RC(3,2)
            RC(3,3)
            RC(3,4)
            RC(3,5)


            /*
             * =================================================
             * ROW 5
             * =================================================
             *
             * Physical:
             *
             * Key 1 = Column 1
             * Key 2 = Column 3
             * Key 3 = Column 4
             * Key 4 = Column 5
             *
             * Software:
             *
             * C6, C4, C3, C2
             */

            RC(4,6)
            RC(4,4)
            RC(4,3)
            RC(4,2)

        >;
    };


    /*
     * ========================================================
     * ROTARY ENCODER
     * ========================================================
     *
     * KY-040
     *
     * CLK = P1.01
     * DT  = P1.02
     * SW  = P1.07
     *
     * Encoder push button is not configured yet.
     */

    encoder: encoder {
        compatible = "alps,ec11";

        a-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;

        steps = <4>;

        status = "okay";
    };
};


/*
 * ============================================================
 * I2C PIN CONTROL
 * ============================================================
 *
 * OLED:
 *
 * SDA = P0.02
 * SCL = P0.29
 *
 * ============================================================
 */

&pinctrl {

    i2c0_default: i2c0_default {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 2)>,
                <NRF_PSEL(TWIM_SCL, 0, 29)>;
        };
    };


    i2c0_sleep: i2c0_sleep {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 2)>,
                <NRF_PSEL(TWIM_SCL, 0, 29)>;

            low-power-enable;
        };
    };
};


/*
 * ============================================================
 * I2C0
 * ============================================================
 */

&i2c0 {

    status = "okay";

    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;

    pinctrl-names =
        "default",
        "sleep";

    clock-frequency = <I2C_BITRATE_STANDARD>;


    /*
     * ========================================================
     * SSD1306 OLED
     * ========================================================
     *
     * 0.91 inch
     * 128 x 32
     * I2C address 0x3C
     */

    oled: ssd1306@3c {

        compatible = "solomon,ssd1306fb";

        reg = <0x3c>;

        width = <128>;
        height = <32>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;

        multiplex-ratio = <31>;

        segment-remap;

        com-invdir;
        com-sequential;

        prechargep = <0x22>;

        status = "okay";
    };
};