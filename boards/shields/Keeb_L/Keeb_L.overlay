#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    /* ========================================================
     * CHOSEN DEVICES
     * ======================================================== */

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;

        zephyr,display = &oled;
    };


    /* ========================================================
     * KEY MATRIX
     *
     * 5 rows x 7 columns
     *
     * Top row:
     * P0.02
     * ======================================================== */

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "col2row";

        row-gpios =
            <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios =
            <&gpio1 4  GPIO_ACTIVE_HIGH>,
            <&gpio1 6  GPIO_ACTIVE_HIGH>,
            <&gpio0 9  GPIO_ACTIVE_HIGH>,
            <&gpio0 10 GPIO_ACTIVE_HIGH>,
            <&gpio1 11 GPIO_ACTIVE_HIGH>,
            <&gpio1 13 GPIO_ACTIVE_HIGH>,
            <&gpio1 15 GPIO_ACTIVE_HIGH>;

        /* Rotary encoder used as a keymap sensor */
        sensors {
            compatible = "zmk,keymap-sensors";
            sensors = <&encoder>;
        };
    };


    /* ========================================================
     * MATRIX TRANSFORM
     * ======================================================== */

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        columns = <7>;
        rows = <5>;

        map = <

            /* Row 0 */
            RC(0,1)
            RC(0,2)
            RC(0,3)
            RC(0,4)
            RC(0,5)
            RC(0,6)

            /* Row 1 */
            RC(1,1)
            RC(1,2)
            RC(1,3)
            RC(1,4)
            RC(1,5)
            RC(1,6)

            /* Row 2 */
            RC(2,0)
            RC(2,1)
            RC(2,2)
            RC(2,3)
            RC(2,4)
            RC(2,5)
            RC(2,6)

            /* Row 3 */
            RC(3,1)
            RC(3,2)
            RC(3,3)
            RC(3,4)
            RC(3,5)
            RC(3,6)

            /* Row 4 */
            RC(4,0)
            RC(4,2)
            RC(4,3)
            RC(4,4)

        >;
    };


    /* ========================================================
     * ROTARY ENCODER
     *
     * A = P1.02
     * B = P1.01
     * ======================================================== */

    encoder: encoder {
        compatible = "alps,ec11";

        a-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;

        steps = <50>;

        status = "okay";
    };
};


/* ============================================================
 * I2C PIN CONTROL
 *
 * OLED:
 *
 * SDA = P0.17
 * SCK/SCL = P0.20
 *
 * ============================================================ */

&pinctrl {

    i2c0_default: i2c0_default {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;

            low-power-enable;
        };
    };
};


/* ============================================================
 * I2C0
 * ============================================================ */

&i2c0 {

    status = "okay";

    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;

    pinctrl-names =
        "default",
        "sleep";

    clock-frequency = <I2C_BITRATE_STANDARD>;


    /* ========================================================
     * SSD1306 OLED
     *
     * 128 x 32
     * I2C address = 0x3C
     * ======================================================== */

    oled: ssd1306@3c {

        compatible = "solomon,ssd1306fb";

        reg = <0x3c>;

        width = <128>;
        height = <32>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;

        multiplex-ratio = <31>;

        segment-remap;

        com-invdir;
        com-sequential;

        prechargep = <0x22>;

        status = "okay";
    };
};