#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	keymap {
		compatible = "zmk,keymap";


		/*
		 * ========================================================
		 * L1
		 * ========================================================
		 *
		 * Physical order:
		 *
		 * R1: C1 C2 C3 C4 C5 C6
		 * R2: C1 C2 C3 C4 C5 C6
		 * R3: C1 C2 C3 C4 C5 C6 C7
		 * R4: C1 C2 C3 C4 C5 C6
		 * R5:       C3 C4 C5    C7
		 * ========================================================
		 */
		default_layer {
			display-name = "L1";

			bindings = <
				/* R1 */
				&kp N6
				&kp N5
				&kp N4
				&kp N3
				&kp N2
				&kp N1

				/* R2 */
				&kp T
				&kp R
				&kp E
				&kp W
				&kp Q
				&kp TAB

				/* R3 */
				&kp BSPC
				&kp G
				&kp F
				&kp D
				&kp S
				&kp A
				&kp ESC

				/* R4 */
				&kp B
				&kp V
				&kp C
				&kp X
				&kp Z
				&kp LSHFT

				/* R5 */
				&kp SPACE
				&kp LCTRL
				&kp LALT
				&kp LGUI
			>;

			/*
			 * EC11:
			 *
			 * Clockwise:
			 * Volume Up
			 *
			 * Counter-clockwise:
			 * Volume Down
			 */
			sensor-bindings = <
				&inc_dec_kp C_VOL_UP C_VOL_DN
			>;
		};


		/*
		 * ========================================================
		 * L2
		 * ========================================================
		 */
		layer_two {
			display-name = "L2";

			bindings = <
				/* R1 */
				&kp N6
				&kp N5
				&kp N4
				&kp N3
				&kp N2
				&kp N1

				/* R2 */
				&kp T
				&kp R
				&kp E
				&kp W
				&kp Q
				&kp TAB

				/* R3 */
				&kp BSPC
				&kp G
				&kp F
				&kp D
				&kp S
				&kp A
				&kp ESC

				/* R4 */
				&kp B
				&kp V
				&kp C
				&kp X
				&kp Z
				&kp LSHFT

				/* R5 */
				&kp SPACE
				&kp LCTRL
				&kp LALT
				&kp LGUI
			>;

			/*
			 * EC11 remains volume control on L2.
			 */
			sensor-bindings = <
				&inc_dec_kp C_VOL_UP C_VOL_DN
			>;
		};
	};
};
