#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <

                /* Row 1 - reversed */
                &kp N6
                &kp N5
                &kp N4
                &kp N3
                &kp N2
                &kp N1

                /* Row 2 - reversed */
                &kp T
                &kp R
                &kp E
                &kp W
                &kp Q
                &kp TAB

                /* Row 3 - reversed */
                &kp BSPC
                &kp G
                &kp F
                &kp D
                &kp S
                &kp A
                &kp ESC

                /* Row 4 - reversed */
                &kp B
                &kp V
                &kp C
                &kp X
                &kp Z
                &kp LSHFT

                /* Row 5 - reversed */
                &kp SPACE
                &kp LCTRL
                &kp LALT
                &kp LGUI
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
    };
};