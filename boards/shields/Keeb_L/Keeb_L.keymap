#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	keymap {
		compatible = "zmk,keymap";


		/*
		 * ========================================================
		 * LAYER 1
		 *
		 * OLED shows:
		 * L1
		 * ========================================================
		 */
		default_layer {
			display-name = "L1";

			bindings = <
				&kp N6
				&kp N5
				&kp N4
				&kp N3
				&kp N2
				&kp N1

				&kp T
				&kp R
				&kp E
				&kp W
				&kp Q
				&kp TAB

				&kp BSPC
				&kp G
				&kp F
				&kp D
				&kp S
				&kp A
				&kp ESC

				&kp B
				&kp V
				&kp C
				&kp X
				&kp Z
				&kp LSHFT

				&kp SPACE
				&kp LCTRL
				&kp LALT
				&kp LGUI
			>;

			/*
			 * Encoder:
			 *
			 * Clockwise        = Volume Up
			 * Counter-clockwise = Volume Down
			 */
			sensor-bindings = <
				&inc_dec_kp C_VOL_UP C_VOL_DN
			>;
		};


		/*
		 * ========================================================
		 * LAYER 2
		 *
		 * OLED shows:
		 * L2
		 * ========================================================
		 */
		layer_two {
			display-name = "L2";

			bindings = <
				&kp N6
				&kp N5
				&kp N4
				&kp N3
				&kp N2
				&kp N1

				&kp T
				&kp R
				&kp E
				&kp W
				&kp Q
				&kp TAB

				&kp BSPC
				&kp G
				&kp F
				&kp D
				&kp S
				&kp A
				&kp ESC

				&kp B
				&kp V
				&kp C
				&kp X
				&kp Z
				&kp LSHFT

				&kp SPACE
				&kp LCTRL
				&kp LALT
				&kp LGUI
			>;

			/*
			 * Encoder:
			 *
			 * Clockwise        = Volume Up
			 * Counter-clockwise = Volume Down
			 */
			sensor-bindings = <
				&inc_dec_kp C_VOL_UP C_VOL_DN
			>;
		};
	};
};
