#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <

                /* =========================================
                 * ROW 0
                 * ========================================= */

                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp N5
                &kp N6


                /* =========================================
                 * ROW 1
                 * ========================================= */

                &kp TAB
                &kp Q
                &kp W
                &kp E
                &kp R
                &kp T


                /* =========================================
                 * ROW 2
                 * ========================================= */

                &kp ESC
                &kp A
                &kp S
                &kp D
                &kp F
                &kp G
                &kp BSPC


                /* =========================================
                 * ROW 3
                 * ========================================= */

                &kp LSHFT
                &kp Z
                &kp X
                &kp C
                &kp V
                &kp B


                /* =========================================
                 * ROW 4
                 * ========================================= */

                &kp LGUI
                &kp LALT
                &kp LCTRL
                &kp SPACE
            >;
        };
    };
};