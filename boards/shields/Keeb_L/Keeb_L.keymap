#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <hal/nrf_gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zephyr,display = &oled;
    };


    /*
     * ========================================================
     * KEY MATRIX
     * ========================================================
     */

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        /*
         * Diode stripe/cathode is toward ROW.
         */
        diode-direction = "col2row";


        /*
         * ROWS
         *
         * TOP -> BOTTOM
         */

        row-gpios =
            <&gpio0 20 GPIO_ACTIVE_HIGH>,
            <&gpio0 22 GPIO_ACTIVE_HIGH>,
            <&gpio0 24 GPIO_ACTIVE_HIGH>,
            <&gpio1 0  GPIO_ACTIVE_HIGH>,
            <&gpio0 11 GPIO_ACTIVE_HIGH>;


        /*
         * COLUMNS
         *
         * Software LEFT -> RIGHT
         *
         * C0 = physical P1.15
         * C1 = physical P1.13
         * C2 = physical P1.11
         * C3 = physical P0.10
         * C4 = physical P0.09
         * C5 = physical P1.06
         * C6 = physical P1.04
         */

        col-gpios =
            <&gpio1 15 GPIO_ACTIVE_HIGH>,
            <&gpio1 13 GPIO_ACTIVE_HIGH>,
            <&gpio1 11 GPIO_ACTIVE_HIGH>,
            <&gpio0 10 GPIO_ACTIVE_HIGH>,
            <&gpio0 9  GPIO_ACTIVE_HIGH>,
            <&gpio1 6  GPIO_ACTIVE_HIGH>,
            <&gpio1 4  GPIO_ACTIVE_HIGH>;
    };


    /*
     * ========================================================
     * MATRIX TRANSFORM
     * ========================================================
     */

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        columns = <7>;
        rows = <5>;

        map = <
            /* Row 0 */
            RC(0,0)
            RC(0,1)
            RC(0,2)
            RC(0,3)
            RC(0,4)
            RC(0,5)

            /* Row 1 */
            RC(1,0)
            RC(1,1)
            RC(1,2)
            RC(1,3)
            RC(1,4)
            RC(1,5)

            /* Row 2 */
            RC(2,0)
            RC(2,1)
            RC(2,2)
            RC(2,3)
            RC(2,4)
            RC(2,5)
            RC(2,6)

            /* Row 3 */
            RC(3,0)
            RC(3,1)
            RC(3,2)
            RC(3,3)
            RC(3,4)
            RC(3,5)

            /* Row 4 */
            RC(4,2)
            RC(4,3)
            RC(4,4)
            RC(4,6)
        >;
    };


    /*
     * ========================================================
     * ENCODER
     * ========================================================
     */

    encoder: encoder {
        compatible = "alps,ec11";

        a-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;

        steps = <4>;

        status = "okay";
    };
};


/*
 * ============================================================
 * I2C
 * ============================================================
 *
 * OLED:
 *
 * SDA = P0.02
 * SCL = P0.29
 *
 */

&i2c0 {
    status = "okay";

    clock-frequency = <I2C_BITRATE_STANDARD>;

    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";


    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";

        reg = <0x3c>;

        width = <128>;
        height = <32>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;

        multiplex-ratio = <31>;

        segment-remap;
        com-invdir;
        com-sequential;

        prechargep = <0x22>;

        status = "okay";
    };
};


/*
 * ============================================================
 * I2C PIN CONTROL
 * ============================================================
 */

&pinctrl {

    i2c0_default: i2c0_default {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 2)>,
                <NRF_PSEL(TWIM_SCL, 0, 29)>;
        };
    };


    i2c0_sleep: i2c0_sleep {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 2)>,
                <NRF_PSEL(TWIM_SCL, 0, 29)>;

            low-power-enable;
        };
    };
};