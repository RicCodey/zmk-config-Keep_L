#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <

                /* Row 0 - left to right */
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp N5
                &kp N6


                /* Row 1 - left to right */
                &kp TAB
                &kp Q
                &kp W
                &kp E
                &kp R
                &kp T


                /* Row 2 - left to right */
                &kp ESC
                &kp A
                &kp S
                &kp D
                &kp F
                &kp G
                &kp BSPC


                /* Row 3 - left to right */
                &kp LSHFT
                &kp Z
                &kp X
                &kp C
                &kp V
                &kp B


                /* Row 4 */
                &kp LGUI
                &kp LALT
                &kp LCTRL
                &kp SPACE
            >;
        };
    };
};