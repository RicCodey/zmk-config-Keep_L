#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Base";

			bindings = <
				&kp N6
				&kp N5
				&kp N4
				&kp N3
				&kp N2
				&kp N1

				&kp T
				&kp R
				&kp E
				&kp W
				&kp Q
				&kp TAB

				&kp BSPC
				&kp G
				&kp F
				&kp D
				&kp S
				&kp A
				&kp ESC

				&kp B
				&kp V
				&kp C
				&kp X
				&kp Z
				&kp LSHFT

				&kp SPACE
				&kp LCTRL
				&kp LALT
				&kp LGUI
			>;
		};

		layer_two {
			display-name = "Layer 2";

			bindings = <
				&kp Q
				&kp W
				&kp E
				&kp R
				&kp T
				&kp Y

				&kp U
				&kp I
				&kp O
				&kp P
				&kp A
				&kp S

				&kp D
				&kp F
				&kp G
				&kp H
				&kp J
				&kp K
				&kp L

				&kp Z
				&kp X
				&kp C
				&kp V
				&kp B
				&kp N

				&kp M
				&kp SPACE
				&kp BSPC
				&kp LSHIFT
			>;

			sensor-bindings = <
				&inc_dec_kp C_VOL_UP C_VOL_DN
			>;
		};
	};
};